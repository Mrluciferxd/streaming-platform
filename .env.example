# Copy to .env.local and fill in. Never commit .env.local.

NODE_ENV=development

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres@localhost:5432/streaming
DATABASE_POOL_MAX=10
# Set to false when connecting through PgBouncer in transaction mode.
DATABASE_PREPARE=true

# --- Video provider ---------------------------------------------------------
# 'r2' (self-hosted pipeline) or 'bunny' (managed). Swappable at any time;
# existing rows keep their own `provider` value so migration is incremental.
VIDEO_PROVIDER=r2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=streaming-media
# Custom domain bound to the R2 bucket. MUST be a subdomain of the app's
# domain, otherwise the browser will not attach the `pb` playback cookie to CDN
# requests and the edge gate will reject every segment.
#   app:  https://example.com
#   cdn:  https://cdn.example.com
R2_PUBLIC_BASE_URL=https://cdn.example.com

BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=

# --- Playback tokens --------------------------------------------------------
# openssl rand -base64 48
PLAYBACK_TOKEN_SECRET=
PLAYBACK_TOKEN_TTL_SEC=21600
# Registrable parent of both the app and CDN hosts, with a leading dot.
PLAYBACK_COOKIE_DOMAIN=.example.com

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 48
AUTH_SECRET=

# --- Client-visible ---------------------------------------------------------
# Must match R2_PUBLIC_BASE_URL (or the Bunny CDN host). Feeds the CSP
# connect-src/media-src allowlist and the <link rel="preconnect">.
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# --- Upload -----------------------------------------------------------------
# The upload endpoints are guarded by an operator session, not a shared secret —
# see src/lib/auth/require-role.ts.
# 20 GB
MAX_UPLOAD_BYTES=21474836480

# --- Transcode worker -------------------------------------------------------
# Scratch space. Needs several GB free per concurrent job.
WORKER_TMP_DIR=/tmp/transcode
# One transcode saturates ~8 vCPU; add machines rather than raising this.
WORKER_CONCURRENCY=1

# --- Cron -------------------------------------------------------------------
# Bearer token Vercel Cron presents to /api/cron/*. openssl rand -base64 48
CRON_SECRET=
# Canonical origin, used by sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Advertising ------------------------------------------------------------
# Everything below is optional. Leave NEXT_PUBLIC_ADS_ENABLED at 0 and the site
# loads no ad script, requests no ad, renders no slot, and extends no CSP.
NEXT_PUBLIC_ADS_ENABLED=0

# Google Ad Manager network code (digits only). Enables the display slots, which
# expect these child ad units to exist in the GAM account:
#   web_header  web_below_player  web_sidebar  web_in_feed
NEXT_PUBLIC_GAM_NETWORK_CODE=

# VAST 4.x / VMAP tag for the pre-roll. Google's public sample tags work for
# testing the integration end to end without a GAM account — a single linear
# inline pre-roll is:
#   https://pubads.g.doubleclick.net/gampad/ads?iu=/21775744923/external/single_ad_samples&sz=640x480&cust_params=sample_ct%3Dlinear&ciu_szs=300x250%2C728x90&gdfp_req=1&output=vast&unviewed_position_start=1&env=vp&impl=s&correlator=
NEXT_PUBLIC_AD_VAST_TAG_URL=

# Frequency cap (ad_placements.frequency_cap). Pre-rolls per browsing session,
# and the minimum gap between them — the gap is what stops an ad landing on
# every episode of a binge.
NEXT_PUBLIC_AD_PREROLL_CAP=3
NEXT_PUBLIC_AD_PREROLL_COOLDOWN_SEC=600

# --- ads.txt ----------------------------------------------------------------
# /ads.txt is generated from these. With none set it returns 404, which is the
# correct answer for a publisher with no authorised sellers — a placeholder file
# would be read as fact.
# Google seller of record, e.g. pub-0000000000000000.
ADS_TXT_GOOGLE_PUB_ID=
# Additional records, verbatim. Newline or semicolon separated, e.g.
#   media.net, 8CU1234567, DIRECT; appnexus.com, 1234, RESELLER
ADS_TXT_ENTRIES=
# Published as the CONTACT= line.
ADS_TXT_CONTACT=
# Serve /app-ads.txt with the same records. Only once a mobile app exists.
ADS_TXT_APP_ADS=0
